<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.Pokedex1"
             Title="{l10n:Tr Key=saveedit_dex}">
    <VerticalStackLayout>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Text="{l10n:Tr Key=gen1_seen}" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Label Text="{l10n:Tr Key=gen1_caught}" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="1"/>
            <CollectionView x:Name="SeenCollection" Grid.Row="1" HeightRequest="250"/>
            <CollectionView x:Name="CaughtCollection" Grid.Row="1" Grid.Column="1" HeightRequest="250"/>
            <Button Text="{l10n:Tr Key=gen1_all_seen}" Grid.Row="2" Clicked="SetSeenAll"/>
            <Button Text="{l10n:Tr Key=gen1_all_caught}" Grid.Row="2" Grid.Column="1" Clicked="SetCaughtAll"/>
            <Button Text="{l10n:Tr Key=gen1_all_unseen}" Grid.Row="3" Clicked="SetSeenNone"/>
            <Button Text="{l10n:Tr Key=gen1_all_uncaught}" Grid.Row="3" Grid.Column="1" Clicked="SetCaughtNone"/>
            <Button Text="{l10n:Tr Key=common_save}" Grid.Row="4" Clicked="save"/>
            <Button Text="{l10n:Tr Key=box_cancel}" Grid.Row="4" Grid.Column="1" Clicked="close"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>