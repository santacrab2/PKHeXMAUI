<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             xmlns:local="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.HallOfFame3"
             Title="{l10n:Tr Key=saveedit_hall_of_fame}">
    <ScrollView>
        <VerticalStackLayout>
            <CollectionView x:Name="HoFCV" HeightRequest="300" SelectionMode="Single" Margin="5"/>
            <Grid ColumnDefinitions="*,*,*">
                <local:comboBox x:Name="CB_Species"/>
                <local:NumericUpDown x:Name="NUD_Members" Grid.Column="1" MinValue="0" MaxValue="5"/>
                <Button Text="{l10n:Tr Key=gen3_clear}" Clicked="B_Clear_Click" Grid.Column="2"/>
            </Grid>
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*,*,*,*,*">
                <Label Text="{l10n:Tr Key=pktab_nickname}"/>
                <Entry x:Name="TB_Nickname" Grid.Column="1"/>
                <Label Text="{l10n:Tr Key=pktab_level}" Grid.Row="1"/>
                <local:NumericUpDown x:Name="NUD_Level" Grid.Column="1" Grid.Row="1" MinValue="1" MaxValue="100"/>
                <Label Text="{l10n:Tr Key=pktab_pid}" Grid.Row="2"/>
                <Entry x:Name="TB_PID" Grid.Column="1" Grid.Row="2"/>
                <CheckBox x:Name="CHK_Shiny" Grid.Row="3"/>
                <Label Text="{l10n:Tr Key=encounter_shiny}" Grid.Column="1" Grid.Row="3"/>
                <Label Text="{l10n:Tr Key=ottab_tid}" Grid.Row="4"/>
                <Entry x:Name="TB_TID" Grid.Column="1" Grid.Row="4"/>
                <Label Text="{l10n:Tr Key=ottab_sid}" Grid.Row="5"/>
                <Entry x:Name="TB_SID" Grid.Column="1" Grid.Row="5"/>
                <Button Text="{l10n:Tr Key=box_cancel}" Clicked="B_Cancel_Click" Grid.Row="6"/>
                <Button Text="{l10n:Tr Key=common_save}" Clicked="B_Save_Click" Grid.Column="1" Grid.Row="6"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>