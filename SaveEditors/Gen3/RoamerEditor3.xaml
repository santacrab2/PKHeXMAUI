<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             xmlns:local="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.RoamerEditor3"
             Title="{l10n:Tr Key=saveedit_roamers}">
    <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*">
        <Label Text="{l10n:Tr Key=pktab_species}" VerticalOptions="Center"/>
        <local:comboBox x:Name="CB_Species" Grid.Column="1"/>
        <Label Text="{l10n:Tr Key=pktab_level}" Grid.Row="1" VerticalOptions="Center"/>
        <local:NumericUpDown x:Name="NUD_Level" Grid.Row="1" Grid.Column="1" MaxValue="100"/>
        <Label Text="{l10n:Tr Key=pktab_pid}" Grid.Row="2" VerticalOptions="Center"/>
        <Entry x:Name="E_PID" Grid.Row="2" Grid.Column="1" TextChanged="TB_PID_TextChanged"/>
        <CheckBox x:Name="CHK_Active" Grid.Row="3"/>
        <Label Text="{l10n:Tr Key=gen3_roaming}" Grid.Row="3" Grid.Column="1" VerticalOptions="Center"/>
        <CheckBox x:Name="CHK_Shiny" Grid.Row="4"/>
        <Label Text="{l10n:Tr Key=encounter_shiny}" Grid.Row="4" Grid.Column="1" VerticalOptions="Center"/>
        <Label Text="{l10n:Tr Key=stats_hp}" Grid.Row="5" VerticalOptions="Center"/>
        <Entry x:Name="E_HPIV" Grid.Row="5" Grid.Column="1" Keyboard="Numeric"/>
        <Label Text="{l10n:Tr Key=stats_attack}" Grid.Row="6" VerticalOptions="Center"/>
        <Entry x:Name="E_ATKIV" Grid.Row="6" Grid.Column="1" Keyboard="Numeric"/>
        <Label Text="{l10n:Tr Key=stats_defense}" Grid.Row="7" VerticalOptions="Center"/>
        <Entry x:Name="E_DEFIV" Grid.Row="7" Grid.Column="1" Keyboard="Numeric"/>
        <Label Text="{l10n:Tr Key=stats_sp_atk}" Grid.Row="8" VerticalOptions="Center"/>
        <Entry x:Name="E_SPAIV" Grid.Row="8" Grid.Column="1" Keyboard="Numeric"/>
        <Label Text="{l10n:Tr Key=stats_sp_def}" Grid.Row="9" VerticalOptions="Center"/>
        <Entry x:Name="E_SPDIV" Grid.Row="9" Grid.Column="1" Keyboard="Numeric"/>
        <Label Text="{l10n:Tr Key=stats_speed}" Grid.Row="10" VerticalOptions="Center"/>
        <Entry x:Name="E_SPEIV" Grid.Row="10" Grid.Column="1" Keyboard="Numeric"/>
        <Button Text="{l10n:Tr Key=box_cancel}" Clicked="close" Grid.Row="11"/>
        <Button Text="{l10n:Tr Key=common_save}" Clicked="Save" Grid.Row="11" Grid.Column="1"/>
    </Grid>
</ContentPage>