<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.ChatterEditor"
             Title="{l10n:Tr Key=gen4_chatter_editor}">
    <ScrollView>
        <Grid ColumnDefinitions="*,*" RowDefinitions="2*,*">
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*">
                <Button Text="{l10n:Tr Key=gen4_play_recording}" Clicked="B_PlayRecording_Click"/>
                <CheckBox x:Name="CHK_Initialized" CheckedChanged="CHK_Initialized_CheckChanged" Grid.Row="1"/>
                <Label Text="{l10n:Tr Key=gen4_initialized}" Grid.Row="1" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center"/>
                <Label Text="{l10n:Tr Key=gen4_chaos_ratio}" Grid.Row="2" VerticalOptions="Center" HorizontalOptions="Center"/>
                <Entry x:Name="Entry_Confusion" Keyboard="Numeric" Grid.Row="2" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center"/>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="*,*,*">
                <Button Text="{l10n:Tr Key=gen4_import_pcm}" Clicked="B_Importpcm_clicked"/>
                <Button Text="{l10n:Tr Key=gen4_export_pcm}" Clicked="B_Exportpcm_clicked" Grid.Row="1"/>
                <Button Text="{l10n:Tr Key=gen4_export_wav}" Clicked="B_Exportwav_clicked" Grid.Row="2"/>
            </Grid>
            <Button Text="{l10n:Tr Key=common_save}" Clicked="B_Save_Click" Grid.Row="1"/>
            <Button Text="{l10n:Tr Key=box_cancel}" Clicked="B_Cancel_Click" Grid.Row="1" Grid.Column="1"/>
        </Grid>
    </ScrollView>
</ContentPage>