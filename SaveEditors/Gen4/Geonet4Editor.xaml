<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.Geonet4Editor"
             Title="{l10n:Tr Key=saveedit_geonet}">
    <ScrollView>
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*,*,*">
                <Button x:Name="B_SetAllLocations" Text="{l10n:Tr Key=gen4_set_all_locations}" Clicked="B_SetAllLocations_Clicked"/>
                <Button x:Name="B_SetAllLegalLocations" Text="{l10n:Tr Key=gen4_set_all_legal}" Clicked="B_SetAllLegalLocations_Clicked" Grid.Column="1"/>
                <Button x:Name="B_ClearAllLocations" Text="{l10n:Tr Key=gen4_clear_all_locations}" Clicked="B_ClearAllLocations_Clicked" Grid.Column="2"/>
            </Grid>
            <CollectionView x:Name="CV_Geonet" HeightRequest="400"/>
            <Grid ColumnDefinitions="*,*">
                <CheckBox x:Name="CHK_GlobalFlag"/>
                <Label VerticalOptions="Center" Text="{l10n:Tr Key=gen4_globally_visible}" Grid.Column="1"/>
            </Grid>
            <Grid ColumnDefinitions="*,*">
                <Button x:Name="B_Save" Text="{l10n:Tr Key=common_save}" Clicked="B_Save_Clicked"/>
                <Button x:Name="B_Cancel" Text="{l10n:Tr Key=box_cancel}" Clicked="B_Cancel_Clicked" Grid.Column="1"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>