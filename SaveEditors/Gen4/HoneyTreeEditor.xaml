<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             xmlns:l="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.HoneyTreeEditor"
             Title="{l10n:Tr Key=gen4_sweet_tree}">
    <VerticalStackLayout>
        <Label Text="{l10n:Tr Key=gen4_bounsweet_tree}" x:Name="L_Munchlax" />
        <Label x:Name="L_Tree0" />
        <Label Text="{l10n:Tr Key=gen4_sweet_tree}"/>
        <l:comboBox x:Name="CB_TreeList" SelectedIndexChanged="ChangeTree"/>
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*,*,*,*,*">
            <Label Text="{l10n:Tr Key=gen4_tree_info}"/>
            <Label Text="{l10n:Tr Key=gen4_group}" Grid.Row="1"/>
            <Label Text="{l10n:Tr Key=encounter_slot}" Grid.Row="1" Grid.Column="1"/>
            <l:NumericUpDown x:Name="NUD_Group" Grid.Row="2" MaxValue="3" MinValue="0" ValueChanged="ChangeGroupSlot"/>
            <l:NumericUpDown x:Name="NUD_Slot" Grid.Row="2" Grid.Column="1" MaxValue="5" MinValue="0" ValueChanged="ChangeGroupSlot"/>
            <Label x:Name="L_Species" Grid.Row="2" Grid.Column="2"/>
            <Label Text="{l10n:Tr Key=gen4_time_remaining}" Grid.Row="3"/>
            <Label Text="{l10n:Tr Key=gen4_shake}" Grid.Row="3" Grid.Column="1"/>
            <l:NumericUpDown x:Name="NUD_Time" Grid.Row="4" MinValue="0" MaxValue="1440"/>
            <l:NumericUpDown x:Name="NUD_Shake" Grid.Row="4" Grid.Column="1" MinValue="0" MaxValue="3"/>
            <Button x:Name="B_Catchable" Text="{l10n:Tr Key=gen4_set_catchable}" Clicked="B_Catchable_Clicked" Grid.Row="5"/>
            <Button x:Name="B_Cancel" Text="{l10n:Tr Key=box_cancel}" Clicked="B_Cancel_Clicked" Grid.Row="6"/>
            <Button x:Name="B_Save" Text="{l10n:Tr Key=common_save}" Clicked="B_Save_Clicked" Grid.Row="6" Grid.Column="1"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>