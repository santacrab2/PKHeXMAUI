<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.MiscPokeGear"
             Title="{l10n:Tr Key=gen4_pok_gear}">
    <ScrollView Orientation="Both">
        <Grid x:Name="G_pokegear" RowDefinitions="*,*,*" ColumnDefinitions="*,*">
            <CollectionView x:Name="CV_Pokegear" Grid.Column="1" Grid.RowSpan="3" HeightRequest="500" />
            <Button x:Name="B_PokegearAll" Text="{l10n:Tr Key=common_give_all}" Clicked="B_GiveAll_Click" />
            <Button x:Name="B_PokegearDel" Grid.Row="1" Text="{l10n:Tr Key=gen4_delete_all}" Clicked="B_DeleteAll_Click" />
            <Button x:Name="B_PokegearGiveAllNoTrainers" Text="{l10n:Tr Key=gen4_give_all}" Grid.Row="2" Clicked="B_GiveAllNoTrainers_Click" />
        </Grid>
    </ScrollView>
</ContentPage>