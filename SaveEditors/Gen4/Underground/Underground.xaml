<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             xmlns:l="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.Underground"
             Title="{l10n:Tr Key=saveedit_underground}">
    <ScrollView>
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*">
                <Label Text="{l10n:Tr Key=gen4_score}"/>
                <Label Text="{l10n:Tr Key=gen4_people_met}" Grid.Row="1"/>
                <l:NumericUpDown MinValue="0" MaxValue="999999" x:Name="NUD_PlayersMet" Grid.Row="1" Grid.Column="1"/>
                <Label Text="{l10n:Tr Key=gen4_gifts_given}" Grid.Row="2"/>
                <l:NumericUpDown x:Name="NUD_GiftsGiven" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="2"/>
                <Label Text="{l10n:Tr Key=gen4_obtained_flags}" Grid.Row="3"/>
                <l:NumericUpDown x:Name="NUD_FlagsObtained" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="3"/>
                <Label Text="{l10n:Tr Key=gen4_crystals_obtained}" Grid.Row="4"/>
                <l:NumericUpDown x:Name="NUD_Spheres" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="4"/>
                <Label Text="{l10n:Tr Key=gen4_fossils_obtained}" Grid.Row="5"/>
                <l:NumericUpDown x:Name="NUD_Fossils" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="5"/>
                <Label Text="{l10n:Tr Key=gen4_trap_hits}" Grid.Row="6"/>
                <l:NumericUpDown x:Name="NUD_TrapPlayers" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="6"/>
                <Label Text="{l10n:Tr Key=gen4_trap_hits_2}" Grid.Row="7"/>
                <l:NumericUpDown x:Name="NUD_TrapSelf" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="7"/>
                <Label Text="{l10n:Tr Key=gen4_players_helped}" Grid.Row="8"/>
                <l:NumericUpDown x:Name="NUD_HelpedOthers" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="8"/>
                <Label Text="{l10n:Tr Key=gen4_gifts_received}" Grid.Row="9"/>
                <l:NumericUpDown x:Name="NUD_GiftsReceived" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="9"/>
                <Label Text="{l10n:Tr Key=gen4_my_flag_taken}" Grid.Row="10"/>
                <l:NumericUpDown x:Name="NUD_MyFlagTaken" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="10"/>
                <Label Text="{l10n:Tr Key=gen4_restored_flags}" Grid.Row="11"/>
                <l:NumericUpDown x:Name="NUD_MyFlagRecovered" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="11"/>
                <Label Text="{l10n:Tr Key=gen4_base_moved}" Grid.Row="12"/>
                <l:NumericUpDown x:Name="NUD_MyBaseMoved" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="12"/>
                <Label Text="{l10n:Tr Key=gen4_caught_flags}" Grid.Row="13"/>
                <l:NumericUpDown x:Name="NUD_FlagsCaptured" MinValue="0" MaxValue="999999" Grid.Column="1" Grid.Row="13"/>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>