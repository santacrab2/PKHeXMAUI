<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             xmlns:l="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.MiscMain5"
             Title="{l10n:Tr Key=shell_main}">
    <ScrollView>
        <VerticalStackLayout>
            <Border Stroke="White" StrokeThickness="1">
                <Grid x:Name="GB_Flydest" RowDefinitions="*,*,*">
                    <Label Text="{l10n:Tr Key=gen4_flight_destinations}"/>
                    <Button x:Name="B_AllFlydest" Text="{l10n:Tr Key=gen5_select_all}" Clicked="B_AllFlyDest_Click" Grid.Row="1"/>
                    <CollectionView x:Name="CV_Flydest" HeightRequest="200" Grid.Row="2"/>
                </Grid>
            </Border>
            <Border x:Name="GB_Roamer" Stroke="White" StrokeThickness="1">
                <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*">
                    <Label Text="{l10n:Tr Key=saveedit_roamers}"/>
                    <Label Text="{l10n:Tr Key=gen5_tornado}" Grid.Row="1"/>
                    <l:comboBox x:Name="CB_Roamer641" Grid.Row="1" Grid.Column="1"/>
                    <Label Text="{l10n:Tr Key=gen5_thundercloud}" Grid.Row="2"/>
                    <l:comboBox x:Name="CB_Roamer642" Grid.Row="2" Grid.Column="1"/>
                    <Label Text="{l10n:Tr Key=gen5_roamer_state}" Grid.Row="3"/>
                    <l:comboBox x:Name="CB_RoamStatus" Grid.Row="3" Grid.Column="1"/>
                </Grid>
            </Border>
            <Border Stroke="White" StrokeThickness="1">
                <Grid ColumnDefinitions="*,*">
                    <CheckBox x:Name="CHK_LibertyPass"/>
                    <Label x:Name="L_LibertyPass" Text="{l10n:Tr Key=gen5_activate_free_pass}" Grid.Column="1"/>
                </Grid>
            </Border>
            <Border x:Name="GB_KeySystem" Stroke="White" StrokeThickness="1">
                <Grid  RowDefinitions="*,*,*">
                    <Label Text="{l10n:Tr Key=gen5_keys_unlocked}"/>
                    <Button x:Name="B_UnlockAllKeys" Text="{l10n:Tr Key=gen5_select_all}" Clicked="B_AllKeys_Click" Grid.Row="1"/>
                    <CollectionView x:Name="CV_Keys" HeightRequest="200" Grid.Row="2"/>
                </Grid>
            </Border>
            <Border Stroke="White" StrokeThickness="1">
                <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*">
                    <Label Text="{l10n:Tr Key=gen5_record}"/>
                    <l:NumericUpDown x:Name="NUD_Record16" Grid.Column="1"/>
                    <Label Text="{l10n:Tr Key=stats_stats}" Grid.Row="1"/>
                    <l:NumericUpDown x:Name="NUD_Record16V" Grid.Column="1" Grid.Row="1"/>
                    <Label Text="{l10n:Tr Key=gen5_record}" Grid.Row="2"/>
                    <l:NumericUpDown x:Name="NUD_Record32" Grid.Row="2" Grid.Column="1"/>
                    <Label Text="{l10n:Tr Key=stats_stats}" Grid.Row="3"/>
                    <l:NumericUpDown x:Name="NUD_Record32V" Grid.Row="3" Grid.Column="1"/>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>