<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
            android:TabbedPage.ToolbarPlacement="Bottom"
             x:Class="PKHeXMAUI.Items"
            x:Name="ItemsMain"
             Title="{l10n:Tr Key=saveedit_items}"
             BarBackgroundColor="#303030"
            SelectedTabColor="#C8C8C8"
            UnselectedTabColor="#919191"
            BarTextColor="White">
    <ContentPage Title="{l10n:Tr Key=saveedit_items}">
        <ScrollView>
            <StackLayout>
                <Button Text="{l10n:Tr Key=saveedit_save_items}" Clicked="SaveItemsClicked" x:Name="saveitems"></Button>
                <Button Text="{l10n:Tr Key=box_cancel}" Clicked="CloseItems"/>
            </StackLayout>
        </ScrollView>
            
    </ContentPage>

</TabbedPage>