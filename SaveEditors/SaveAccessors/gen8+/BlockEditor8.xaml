<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             xmlns:local="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.BlockEditor8"
             Title="{l10n:Tr Key=accessor_block_editor}">
    <ScrollView>
    <VerticalStackLayout>
            <local:comboBox x:Name="BlockKey_Picker" SelectedIndexChanged="Update_BlockCV" BackgroundColor="Transparent">
            </local:comboBox>
            <Label x:Name="BlockSummary" IsVisible="false"/>
            <Editor HeightRequest="400"  x:Name="BlockEditor_Hex"/>
            <Grid x:Name="BlockStack">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>

                </Grid.RowDefinitions>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"></RowDefinition>
                    <RowDefinition Height="4*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <Button Text="{l10n:Tr Key=accessor_export_blocks_to}" Clicked="ExportBlocksFolder"/>
                <Button Grid.Column="1" Text="{l10n:Tr Key=accessor_import_blocks_from}" Clicked="ImportBlocksFolder"/>
                <Button Grid.Row="1" Text="{l10n:Tr Key=accessor_export_current_block}" Clicked="ExportCurrentBlock_Clicked"/>
                <Button Grid.Row="1" Grid.Column="1" Text="{l10n:Tr Key=accessor_import_current_block}" Clicked="ImportCurrentBlock_Clicked"/>
                <Button Grid.Row="2" Text="{l10n:Tr Key=accessor_export_all}" Clicked="ExportAllSingleFile"/>
                <Grid Grid.Row="2" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="CHK_DataOnly" HorizontalOptions="Start"/>
                    <Label Text="{l10n:Tr Key=accessor_blocks_only}" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <CheckBox x:Name="CHK_Key" Grid.Row="1" HorizontalOptions="Start"/>
                    <Label Text="{l10n:Tr Key=accessor_include_32_bit}" Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <CheckBox x:Name="CHK_Type" Grid.Row="2" HorizontalOptions="Start"/>
                    <Label Text="{l10n:Tr Key=accessor_include_attribute_info}" Grid.Row="2" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <CheckBox x:Name="CHK_FakeHeader" Grid.Row="3" HorizontalOptions="Start"/>
                    <Label Text="{l10n:Tr Key=accessor_mark_block_start}" Grid.Row="3" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>
            </Grid>
            <Button x:Name="BE_Close" Text="{l10n:Tr Key=common_close}" Clicked="CloseBlockEditor8"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
    
