<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             xmlns:l="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.TrainerEditor7Ultra"
             Title="{l10n:Tr Key=gen1_trainer_editor}">
    <VerticalStackLayout>
        <Grid Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Text="{l10n:Tr Key=gen7_surf_score}"/>
            <Label Text="{l10n:Tr Key=gen7_melemele_island_2}" Grid.Row="1" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="MeleSurfScoreEntry" Grid.Row="1" Grid.Column="1"/>
            <Label Text="{l10n:Tr Key=gen7_akala_island}" Grid.Row="2" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="AkaSurfScoreEntry" Grid.Row="2" Grid.Column="1"/>
            <Label Text="{l10n:Tr Key=gen7_ulaula_island}" Grid.Row="3" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="UlaSurfScoreEntry" Grid.Row="3" Grid.Column="1"/>
            <Label Text="{l10n:Tr Key=gen7_melemele_island}" Grid.Row="4" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="PoniSurfScoreEntry" Grid.Row="4" Grid.Column="1"/>
            <Label Text="{l10n:Tr Key=gen7_rotom}" Grid.Row="5" VerticalOptions="Center"/>
            <Label Text="{l10n:Tr Key=gen7_rotom_ot}" Grid.Row="6" VerticalOptions="Center"/>
            <Entry x:Name="RotomOTEntry" Grid.Row="6" Grid.Column="1"/>
            <Label Text="{l10n:Tr Key=common_friendship}" Grid.Row="7" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="AffectionEntry" Grid.Row="7" Grid.Column="1"/>
            <CheckBox x:Name="Loto1Check" Grid.Row="8"/>
            <Label Text="{l10n:Tr Key=gen7_lottery_1_top}" Grid.Row="8" Grid.Column="1" VerticalOptions="Center"/>
            <CheckBox x:Name="Loto2Check" Grid.Row="9"/>
            <Label Text="{l10n:Tr Key=gen7_lottery_2_top}" Grid.Row="9" Grid.Column="1" VerticalOptions="Center"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>