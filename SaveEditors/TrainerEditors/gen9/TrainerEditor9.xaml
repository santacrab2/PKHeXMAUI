<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.TrainerEditor9"
             Title="{l10n:Tr Key=gen6_overview}">
    <VerticalStackLayout>
        <Grid Padding="10">
        
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Text="{l10n:Tr Key=gen6_trainer_name}" HorizontalOptions="End" VerticalOptions="Center"></Label>
            <Entry x:Name="TrainerNameEditor" Grid.Column="1"/>
            <Picker x:Name="TrainerGenderPicker" Grid.Column="2"/>
        </Grid>
        <Grid Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Text="{l10n:Tr Key=ottab_sid}" HorizontalOptions="End" VerticalOptions="Center"/>
            <Entry x:Name="TrainerSIDEditor" Grid.Column="1"/>
            <Label Text="{l10n:Tr Key=ottab_tid}" Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center"/>
            <Entry x:Name="TrainerTIDEditor" Grid.Column="3" />
        </Grid>
        <Grid Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Text="$:" HorizontalOptions="End" VerticalOptions="Center"/>
            <Entry x:Name="TrainerMoneyEditor" Grid.Column="1"/>
            <Button x:Name="MoneyButton" Text="+" Clicked="MaxMoney" Grid.Column="2"/>
            <Label Text="{l10n:Tr Key=gen9_lp}" HorizontalOptions="End" VerticalOptions="Center" Grid.Row="1"/>
            <Entry x:Name="TrainerLPEditor" Grid.Row="1" Grid.Column="1"/>
            <Button x:Name="LPButton" Text="+" Clicked="MaxLP" Grid.Column="2" Grid.Row="1"/>
        </Grid>
        <Picker x:Name="VersionPicker" HorizontalOptions="Center" VerticalOptions="Center"/>
        <Grid Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Text="{l10n:Tr Key=ottab_language}" HorizontalOptions="End" VerticalOptions="Center"/>
            <Picker x:Name="LanguagePicker" Grid.Column="1"/>
        </Grid>
        <Grid Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Text="{l10n:Tr Key=gen1_hour}" HorizontalOptions="End" VerticalOptions="Center"/>
            <Entry x:Name="TrainerHoursEditor" Grid.Column="1"/>
            <Label Text="{l10n:Tr Key=gen6_min}" HorizontalOptions="End" VerticalOptions="Center" Grid.Column="2"/>
            <Entry x:Name="TrainerMinutesEditor" Grid.Column="3"/>
            <Label Text="{l10n:Tr Key=gen1_seconds}" HorizontalOptions="End" VerticalOptions="Center" Grid.Column="4"/>
            <Entry x:Name="TrainerSecondsEditor" Grid.Column="5"/>
        </Grid>
        <Grid Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Text="{l10n:Tr Key=gen1_game_start_time}" HorizontalOptions="End" VerticalOptions="Center"/>
            <DatePicker x:Name="GameStartedPicker" Grid.Column="1"/>
            <Label Text="{l10n:Tr Key=gen6_last_save}" HorizontalOptions="End" VerticalOptions="Center" Grid.Row="1"/>
            <DatePicker x:Name="LastSavedPicker" Grid.Column="1" Grid.Row="1"/>
        </Grid>
        <TimePicker x:Name="LastSavedTimePicker" HorizontalOptions="Center" VerticalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>