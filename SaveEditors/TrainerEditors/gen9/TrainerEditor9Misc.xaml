<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             xmlns:l="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.TrainerEditor9Misc"
             Title="{l10n:Tr Key=saveedit_miscellaneous}">
    <VerticalStackLayout>
        <Label Text="{l10n:Tr Key=gen6_map_position}" HorizontalOptions="Center"/>
        <Grid Padding="10" ColumnDefinitions="*,*" RowDefinitions="*,*,*,*">
            <Label Text="{l10n:Tr Key=gen1_x_coord}" HorizontalOptions="End" VerticalOptions="Center"/>
            <l:NumericUpDown x:Name="TrainerXCoordinateEditor" Grid.Column="1"/>
            <Label Text="{l10n:Tr Key=gen1_y_coord}" HorizontalOptions="End" VerticalOptions="Center" Grid.Row="1"/>
            <l:NumericUpDown x:Name="TrainerYCoordinateEditor" Grid.Column="1" Grid.Row="1"/>
            <Label Text="{l10n:Tr Key=gen1_z_coord}" HorizontalOptions="End" VerticalOptions="Center" Grid.Row="2"/>
            <l:NumericUpDown x:Name="TrainerZCoordinateEditor" Grid.Column="1" Grid.Row="2"/>
            <Label Text="{l10n:Tr Key=gen6_wheel}" HorizontalOptions="End" VerticalOptions="Center" Grid.Row="3"/>
            <l:NumericUpDown x:Name="TrainerRotationEditor" Grid.Column="1" Grid.Row="3"/>
        </Grid>
        <Button x:Name="AllFlyButton" Text="{l10n:Tr Key=gen9_unlock_all_fly}" Clicked="UnlockFlyLocations"/>
        <Button x:Name="StakesButton" Text="{l10n:Tr Key=gen9_collect_all_stakes}" Clicked="CollectStakes"/>
        <Button x:Name="TMRecipeButton" Text="{l10n:Tr Key=gen9_unlock_all_tm}" Clicked="UnlockTMRecipes"/>
        <Button x:Name="BikeButton" Text="{l10n:Tr Key=gen9_unlock_all_bike}" Clicked="UnlockBike"/>
        <Button x:Name="FashionButton" Text="{l10n:Tr Key=gen9_unlock_all_costumes}" Clicked="UnlockFashion"/>
    </VerticalStackLayout>
</ContentPage>