<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.MoveShopEditor"
             Title="{l10n:Tr Key=common_move_shop_editor}">
    <ScrollView>
    <VerticalStackLayout>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Text="{l10n:Tr Key=common_number}"/>
            <Label Grid.Column="1" Text="{l10n:Tr Key=shell_moves}"/>
            <Label Grid.Column="2" Text="{l10n:Tr Key=common_purchased}"/>
            <Label Grid.Column="3" Text="{l10n:Tr Key=common_known}"/>
        </Grid>
        <CollectionView x:Name="moveshopcollection" HeightRequest="500" WidthRequest="400"/>
        <Button x:Name="GiveAll" Text="{l10n:Tr Key=common_give_all}" Clicked="GiveAllMoveShop"/>
        <Button x:Name="RemoveAll" Text="{l10n:Tr Key=common_remove_all}" Clicked="RemoveAllMoveShop"/>
        <Button Text="{l10n:Tr Key=common_save}" Clicked="SaveMoveShop"/>
        <Button Text="{l10n:Tr Key=common_close}" Clicked="CloseUpShop"/>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>