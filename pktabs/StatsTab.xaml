<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:l10n="clr-namespace:PKHeXMAUI"
             xmlns:l="clr-namespace:PKHeXMAUI"
             x:Class="PKHeXMAUI.StatsTab"
             Title="{l10n:Tr Key=stats_stats}">
    <RefreshView x:Name="StatsRefresh">
        <ScrollView>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Grid.Row="0"
                x:FieldModifier="Public"
                x:Name="statpic"
                Source="iconp.png"
                HeightRequest="50"
                 Grid.ColumnSpan="2"
                   HorizontalOptions="Start"
                   VerticalOptions="Start"
                />
            <Image Source="rare_icon.png" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" x:Name="shinysparklessprite" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Start"/>
            <Image Source="a_egg.png" Grid.Column="0" Grid.Row="0" x:Name="eggsprite" HeightRequest="40" HorizontalOptions="Start" VerticalOptions="End" IsVisible="false"/>
            <Image Grid.Column="0" Grid.Row="0" x:Name="itemsprite" Grid.ColumnSpan="2" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="End" IsVisible="false"/>
            <!--IVS/EVS-->
            <Label Text="{l10n:Tr Key=stats_base}" Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Label Grid.Row="1" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Text="{l10n:Tr Key=stats_individual_values}"/>
            <Label x:Name="EvLabel" Grid.Row="1" Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" Text="{l10n:Tr Key=stats_effort_values}"/>
            <Label IsVisible="false" x:Name="gvlabel" Grid.Row="1" Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" Text="{l10n:Tr Key=stats_ivs}"/>
            <Label Grid.Row="1" Grid.Column="5" HorizontalOptions="Center" VerticalOptions="Center" Text="{l10n:Tr Key=stats_stats}" x:Name="statslabel"/>
            <Label Grid.Row="1" Grid.Column="6"  HorizontalOptions="Start" VerticalOptions="Center" Text="{l10n:Tr Key=stats_maximum}" x:Name="hyperlabel"/>
            <!--HP-->
            <Label Grid.Row="2" Grid.Column="0" HorizontalOptions="End" VerticalOptions="Center" Text="{l10n:Tr Key=stats_hp}"/>
            <Editor IsReadOnly="True" Grid.Row="2" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" x:Name="hpbasedisplay"/>
            <Editor Grid.Row="2" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" x:Name="HPIV" TextChanged="applyhpIV" Keyboard="Numeric"/>
            <Editor Grid.Row="2" Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" x:Name="HPEV" TextChanged="applyhpEV" Keyboard="Numeric"/>
                <Editor IsVisible="false" Grid.Row="2" Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" x:Name="HPGV" TextChanged="applyhpGV" Keyboard="Numeric"/>
            <Editor IsReadOnly="True" Grid.Row="2" Grid.Column="5" HorizontalOptions="Center" VerticalOptions="Center" x:Name="totalhpdisplay"/>
            <CheckBox Grid.Row="2" Grid.Column="6" HorizontalOptions="Center" VerticalOptions="Center" x:Name="hpHyper" CheckedChanged="applyHPhyper"/>
            <!--ATK-->
            <Label Grid.Row="3" Grid.Column="0" HorizontalOptions="End" VerticalOptions="Center" Text="{l10n:Tr Key=stats_attack}"/>
            <Editor IsReadOnly="True" Grid.Row="3" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" x:Name="atkbasedisplay"/>
                <Editor Grid.Row="3" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" x:Name="AtkIV" TextChanged="applyatkIV" Keyboard="Numeric"/>
                <Editor Grid.Row="3" Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" x:Name="AtkEV" TextChanged="applyatkEV" Keyboard="Numeric"/>
                <Editor IsVisible="false" Grid.Row="3" Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" x:Name="AtkGV" TextChanged="applyatkGV" Keyboard="Numeric"/>
            <Editor IsReadOnly="True" Grid.Row="3" Grid.Column="5" HorizontalOptions="Center" VerticalOptions="Center" x:Name="totalatkdisplay"/>
            <CheckBox Grid.Row="3" Grid.Column="6" HorizontalOptions="Center" VerticalOptions="Center" x:Name="ATKHyper" CheckedChanged="applyATKhyper"/>
            <!--DEF-->
            <Label Grid.Row="4" Grid.Column="0" HorizontalOptions="End" VerticalOptions="Center" Text="{l10n:Tr Key=stats_defense}"/>
            <Editor IsReadOnly="True" Grid.Row="4" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" x:Name="defbasedisplay"/>
                <Editor Grid.Row="4" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" x:Name="DEFIV" TextChanged="applydefIV" Keyboard="Numeric"/>
                <Editor Grid.Row="4" Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" x:Name="DEFEV" TextChanged="applydefEV" Keyboard="Numeric"/>
                <Editor IsVisible="false" Grid.Row="4" Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" x:Name="DEFGV" TextChanged="applydefGV" Keyboard="Numeric"/>
            <Editor IsReadOnly="True" Grid.Row="4" Grid.Column="5" HorizontalOptions="Center" VerticalOptions="Center" x:Name="totaldefdisplay"/>
            <CheckBox Grid.Row="4" Grid.Column="6" HorizontalOptions="Center" VerticalOptions="Center" x:Name="DEFHyper" CheckedChanged="applyDEFhyper"/>
            <!--SPA-->
            <Label Grid.Row="5" Grid.Column="0" HorizontalOptions="End" VerticalOptions="Center" Text="{l10n:Tr Key=stats_sp_atk}"/>
            <Editor IsReadOnly="True" Grid.Row="5" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" x:Name="spabasedisplay"/>
                <Editor Grid.Row="5" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPAIV" TextChanged="applyspaIV" Keyboard="Numeric"/>
                <Editor Grid.Row="5" Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPAEV" TextChanged="applyspaEV" Keyboard="Numeric"/>
                <Editor IsVisible="false" Grid.Row="5" Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPAGV" TextChanged="applyspaGV" Keyboard="Numeric"/>
            <Editor IsReadOnly="True" Grid.Row="5" Grid.Column="5" HorizontalOptions="Center" VerticalOptions="Center" x:Name="totalspadisplay"/>
            <CheckBox Grid.Row="5" Grid.Column="6" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPAHyper" CheckedChanged="applySPAhyper"/>
            <!--SPD-->
            <Label Grid.Row="6" Grid.Column="0" HorizontalOptions="End" VerticalOptions="Center" Text="{l10n:Tr Key=stats_sp_def}"/>
            <Editor IsReadOnly="True" Grid.Row="6" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" x:Name="spdbasedisplay"/>
                <Editor Grid.Row="6" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPDIV" TextChanged="applyspdIV" Keyboard="Numeric"/>
                <Editor Grid.Row="6" Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPDEV" TextChanged="applyspdEV" Keyboard="Numeric"/>
                <Editor IsVisible="false" Grid.Row="6" Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPDGV" TextChanged="applyspdGV" Keyboard="Numeric"/>
            <Editor IsReadOnly="True" Grid.Row="6" Grid.Column="5" HorizontalOptions="Center" VerticalOptions="Center" x:Name="totalspddisplay"/>
            <CheckBox Grid.Row="6" Grid.Column="6" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPDHyper" CheckedChanged="applySPDhyper"/>
            <!--SPE-->
            <Label Grid.Row="7" Grid.Column="0" HorizontalOptions="End" VerticalOptions="Center" Text="{l10n:Tr Key=stats_speed}"/>
            <Editor IsReadOnly="True" Grid.Row="7" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" x:Name="spebasedisplay"/>
                <Editor Grid.Row="7" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPEIV" TextChanged="applyspeIV" Keyboard="Numeric"/>
                <Editor Grid.Row="7" Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPEEV" TextChanged="applyspeEV" Keyboard="Numeric"/>
                <Editor IsVisible="false" Grid.Row="7" Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPEGV" TextChanged="applyspeGV" Keyboard="Numeric"/>
            <Editor IsReadOnly="True" Grid.Row="7" Grid.Column="5" HorizontalOptions="Center" VerticalOptions="Center" x:Name="totalspedisplay"/>
            <CheckBox Grid.Row="7" Grid.Column="6" HorizontalOptions="Center" VerticalOptions="Center" x:Name="SPEHyper" CheckedChanged="applySPEhyper"/>
            <!--Totals-->
            <Label Grid.Row="8" Grid.Column="0" HorizontalOptions="End" VerticalOptions="Center" Text="{l10n:Tr Key=stats_total}"/>
            <Editor IsReadOnly="True" Grid.Row="8" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" x:Name="totalbasedisplay"/>
            <Editor IsReadOnly="True" Grid.Row="8" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" x:Name="totalIVdisplay"/>
            <Editor IsReadOnly="True" Grid.Row="8" Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" x:Name="totalEVdisplay"/>
            <!--Hidden Power-->
            <Label x:Name="HiddenPLabel" IsVisible="false" Grid.Row="9" Grid.Column="0" Text="{l10n:Tr Key=stats_weakness_policy}" Grid.ColumnSpan="2" HorizontalOptions="Start" VerticalOptions="Center"/>
            <Picker x:Name="HiddenPowerPicker" IsVisible="false" Grid.Row="9" Grid.Column="2" HorizontalOptions="Start" VerticalOptions="Center" SelectedIndexChanged="applyHiddenPower"/>
            <!--TeraType-->
            <Label x:Name="OvTeralabel" IsVisible="false" Grid.Row="9" Grid.Column="0" Text="{l10n:Tr Key=stats_override_tera_type}" WidthRequest="152" HorizontalOptions="Start" VerticalOptions="Center"></Label>
            <Picker IsVisible="false" Grid.Row="9" Grid.Column="3" Grid.ColumnSpan="2" HorizontalOptions="End" VerticalOptions="Center" x:Name="Teratypepicker" Title="{l10n:Tr Key=stats_tera_type}" SelectedIndexChanged="applytera"></Picker>
            <Label x:Name="OrTeralabel" IsVisible="false" Grid.Row="10" Grid.Column="0" Text="{l10n:Tr Key=stats_original_tera_type}" WidthRequest="152" HorizontalOptions="Start" VerticalOptions="Center"></Label>
            <Picker IsVisible="false" Grid.Row="10" Grid.Column="3" Grid.ColumnSpan="2" HorizontalOptions="End" VerticalOptions="Center" x:Name="MainTeratypepicker" Title="{l10n:Tr Key=stats_tera_type}" SelectedIndexChanged="applymaintera"></Picker>
            <Image x:Name="teratypeimage" IsVisible="false" Grid.Row="10" Grid.Column="5" HeightRequest="64" HorizontalOptions="Center" VerticalOptions="Center"/>
            <!--IVbuttons-->
            <Button  WidthRequest="150" Grid.Row="11" Grid.Column="1" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Text="{l10n:Tr Key=stats_randomize_ivs}" Clicked="randomizeivs" />
            <Button  WidthRequest="150" Grid.Row="11" Grid.Column="4" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Text="{l10n:Tr Key=stats_max_ivs}" Clicked="perfectivs"/>
            <Button x:Name="randomEv"  WidthRequest="150" Grid.Row="12" Grid.Column="1" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Text="{l10n:Tr Key=stats_randomize_evs}" Clicked="randomizeevs"/>
            <Button x:Name="suggestedEv" WidthRequest="150" Grid.Row="12" Grid.Column="4" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Text="{l10n:Tr Key=stats_recommended_evs}" Clicked="suggestedevs"/>
            <!--Dynamax-->
            <Label x:Name="dmaxlabel" IsVisible="false" Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Text="{l10n:Tr Key=stats_dynamax_level}"/>
            <l:NumericUpDown x:Name="dmaxleveleditor" IsVisible="false" Grid.Row="13" Grid.Column="2" ValueChanged="applydmaxlevel" MinValue="0" MaxValue="10"/>
            <CheckBox x:Name="GmaxCheck" IsVisible="false" Grid.Row="13" Grid.Column="3" CheckedChanged="applygmax"/>
            <Label x:Name="gmaxlabel" IsVisible="false" Grid.Row="13" Grid.Column="4" Grid.ColumnSpan="2" VerticalOptions="Center" Text="{l10n:Tr Key=stats_gigantamax}"/>
            <!--Alpha/Noble-->
            <CheckBox x:Name="Alphacheck" IsVisible="false" Grid.Row="14" Grid.Column="0"  CheckedChanged="applyalhpastatus"/>
            <Label x:Name="alphalabel" IsVisible="false" Grid.Row="14" Grid.Column="1" VerticalOptions="Center" Grid.ColumnSpan="2" Text="{l10n:Tr Key=stats_alpha}"/>
            <CheckBox x:Name="Noblecheck" IsVisible="false" Grid.Row="14" Grid.Column="3" CheckedChanged="applynoblestatus"/>
            <Label x:Name="noblelabel" VerticalOptions="Center" IsVisible="false" Grid.Row="14" Grid.Column="4" Grid.ColumnSpan="2" Text="{l10n:Tr Key=stats_royal}"/>






        </Grid>

    </ScrollView>

    </RefreshView>
</ContentPage>